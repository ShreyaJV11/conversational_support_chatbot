# =============================================================================
# HIGHWIRE SUPPORT CHATBOT - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values

# -----------------------------------------------------------------------------
# API KEYS
# -----------------------------------------------------------------------------
# Groq API key for LLM (get from: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
DB_NAME=HIGHWIRE_BOT_DATABASE
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# AZURE CONFIGURATION (for email processing)
# -----------------------------------------------------------------------------
AZURE_CLIENT_ID=your_azure_client_id
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_SECRET=your_azure_client_secret
SUPPORT_MAILBOX_ADDRESS=support@yourcompany.com

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# JWT secret key (generate with: openssl rand -base64 32)
JWT_SECRET_KEY=your_jwt_secret_key_here

# Admin credentials for /token endpoint
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# -----------------------------------------------------------------------------
# ADMIN CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of admin email addresses
# These users can upload files and manage the knowledge base
ADMIN_EMAILS=admin@yourcompany.com,manager@yourcompany.com

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend URLs
# For local development:
#   ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# For staging:
#   ALLOWED_ORIGINS=https://staging.yourcompany.com,https://admin.staging.yourcompany.com
# For production:
#   ALLOWED_ORIGINS=https://yourcompany.com,https://admin.yourcompany.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# OPTIONAL: MONITORING & LOGGING
# -----------------------------------------------------------------------------
# SENTRY_DSN=your_sentry_dsn_here
# LOG_LEVEL=INFO
# ENVIRONMENT=development
