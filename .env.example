# Database Configuration
DB_NAME=HIGHWIRE_BOT_DATABASE
DB_USER=postgres
DB_PASSWORD=change_this_password
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Secret (generate with: openssl rand -base64 48)
JWT_SECRET_KEY=change_this_to_a_long_random_string_at_least_32_characters

# GROQ API Key (get from: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Azure Configuration (for email processing)
AZURE_CLIENT_ID=your_azure_client_id
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_SECRET=your_azure_client_secret
SUPPORT_MAILBOX_ADDRESS=support@yourdomain.com

# Admin Credentials (optional, defaults to admin/highwire123)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
